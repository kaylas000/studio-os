{
  "name": "studio-os",
  "version": "2.1.0",
  "description": "Meta-system, Living Component Library, and Interactive Showcase Portal for Next-Gen Web Studio",
  "private": true,
  "type": "module",
  "bin": {
    "studio": "./core-engine/bin/studio.js"
  },
  "workspaces": [
    "showcase-site",
    "projects/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=showcase-site",
    "build": "npm run build --workspace=showcase-site",
    "preview": "npm run preview --workspace=showcase-site",
    "studio": "node core-engine/bin/studio.js",
    "studio:new": "node core-engine/bin/studio.js new",
    "studio:harvest": "node core-engine/bin/studio.js harvest",
    "studio:audit": "node core-engine/bin/studio.js audit",
    "test": "node test-verification.mjs",
    "verify": "node test-verification.mjs",
    "smoke": "npm run build --workspace=projects/client-vylet && node projects/client-vylet/scripts/smoke.mjs",
    "audit": "node core-engine/bin/studio.js audit",
    "vault": "node core-engine/bin/studio.js vault",
    "tokens": "node core-engine/bin/studio.js tokens"
  },
  "keywords": [
    "web-studio",
    "design-system",
    "anti-slop",
    "hollywood-intros",
    "seo-by-design",
    "zero-bug",
    "fluid-responsive"
  ],
  "author": "STUDIO OS Core Team",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1"
  }
}